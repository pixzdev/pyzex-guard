# ============================================================
# Pyzex Guard — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# No real credentials are stored in this repository.
# ============================================================

# --- AI provider (OpenAI-compatible endpoint) -----------------
# Sponsor default for this hackathon: the SumoPod-hosted GLM
# deployment. Any OpenAI-compatible Chat Completions endpoint works.
WORKBUDDY_BASE_URL=https://ai.sumopod.com/v1
# API key issued by the provider (format: sk-xxxxxxxx). Leave empty
# to run in demo mode; never hardcode keys anywhere else.
WORKBUDDY_API_KEY=
# Exact model ID exposed by the endpoint. Do not substitute a
# display name — must match the provider's model catalog.
WORKBUDDY_MODEL=glm-5.3-flash

# --- Privacy (security-critical) ------------------------------
# hide   → strip values entirely, generic marker
# redact → typed placeholders (RECOMMENDED, default)
# show   → send original values; requires the explicit opt-in below
SENSITIVE_DATA=redact
# Double opt-in for SHOW mode. Both must be true; otherwise the app
# fails closed to redaction.
ALLOW_SENSITIVE_DATA_TO_AI=false

# --- Reliability ----------------------------------------------
# true  → clearly-labeled deterministic MOCK FALLBACK when the
#         provider is unavailable (jury-safe demonstrations)
# false → provider failures return explicit errors, never mock data
DEMO_MODE=true

# --- Database (Neon PostgreSQL, sanitized audit records) ------
# Leave empty to run without persistence. postgres:// URLs only.
DATABASE_URL=

# --- Server ---------------------------------------------------
PORT=3000
