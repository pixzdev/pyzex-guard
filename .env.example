# ============================================================
# Pyzex Guard — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# No real credentials are stored in this repository.
# ============================================================

# --- AI provider selection ------------------------------------
# sumopod  → SumoPod sponsor endpoint (default for this hackathon)
# tencent  → Tencent Cloud OpenAI-compatible inference (TI-ONE / Hunyuan gateway)
# custom   → any other OpenAI-compatible endpoint
# auto     → first fully configured profile wins (default)
AI_PROVIDER=auto

# --- SumoPod (sponsor default, OpenAI-compatible) -------------
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
# API key issued by SumoPod (format: sk-xxxxxxxx). Leave empty to run
# in demo mode; never hardcode keys anywhere else.
SUMOPOD_API_KEY=
# Exact model ID exposed by the endpoint. Do not substitute a
# display name — must match the provider's model catalog.
SUMOPOD_MODEL=glm-5.3-flash

# --- Tencent Cloud ecosystem (optional alternate profile) -----
# Point at any OpenAI-compatible inference endpoint in your Tencent
# Cloud account (e.g. a TI-ONE inference endpoint or a Hunyuan
# OpenAI-compatible gateway). Same adapter, same privacy pipeline.
TENCENT_BASE_URL=
TENCENT_API_KEY=
TENCENT_MODEL=

# --- Custom OpenAI-compatible endpoint (optional) -------------
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Privacy (security-critical) ------------------------------
# hide   → strip values entirely, generic marker
# redact → typed placeholders (RECOMMENDED, default)
# show   → send original values; requires the explicit opt-in below
SENSITIVE_DATA=redact
# Double opt-in for SHOW mode. Both must be true; otherwise the app
# fails closed to redaction.
ALLOW_SENSITIVE_DATA_TO_AI=false

# --- Reliability ----------------------------------------------
# true  → clearly-labeled deterministic MOCK FALLBACK when the
#         provider is unavailable (jury-safe demonstrations)
# false → provider failures return explicit errors, never mock data
DEMO_MODE=true

# --- Database (Neon PostgreSQL, sanitized audit records) ------
# Leave empty to run without persistence. postgres:// URLs only.
DATABASE_URL=

# --- Server ---------------------------------------------------
PORT=3000
